#!/bin/bash
# Setup Claude work profile (only for work machines)

{{- if .work }}

# Create work profile directory
mkdir -p "$HOME/.claude/profiles/work"

# Create work profile settings.json
cat > "$HOME/.claude/profiles/work/settings.json" << 'EOF'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "askBeforeRunningTool": false,
  "includeCoAuthoredBy": false,
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "arn:aws:bedrock:us-east-1:193501891505:application-inference-profile/8o4sd2ed6pmp",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "arn:aws:bedrock:us-east-1:193501891505:application-inference-profile/iiuk2ti6jk83",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "arn:aws:bedrock:us-east-1:193501891505:application-inference-profile/hx5i4e96qwf8",
    "AWS_PROFILE": "ai_codegen",
    "AWS_REGION": "us-east-1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "arn:aws:bedrock:us-east-1:193501891505:application-inference-profile/8o4sd2ed6pmp",
    "CLAUDE_CODE_USE_BEDROCK": "1"
  },
  "feedbackSurveyState": {
    "lastShownTime": 1755857465860
  }
}
EOF

echo "✓ Claude work profile configured"

{{- else }}

# Remove work profile if it exists (personal machine)
if [ -d "$HOME/.claude/profiles/work" ]; then
  rm -rf "$HOME/.claude/profiles/work"
  echo "✓ Claude work profile removed (personal machine)"
fi

{{- end }}
