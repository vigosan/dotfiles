# ============================================================================
# Editor Aliases
# ============================================================================

alias vim='nvim'
alias vi='nvim'

# ============================================================================
# Git Functions
# ============================================================================

function git_current_branch() {
  local ref
  ref=$(git symbolic-ref --quiet HEAD 2> /dev/null)
  local ret=$?
  if [[ $ret != 0 ]]; then
    [[ $ret == 128 ]] && return  # no git repo.
    ref=$(git rev-parse --short HEAD 2> /dev/null) || return
  fi
  echo ${ref#refs/heads/}
}

# ============================================================================
# Git Aliases
# ============================================================================

alias gclean='git clean -id'
alias gco='git checkout'
alias ggpull='git pull origin "$(git_current_branch)"'
alias ggpush='git push origin "$(git_current_branch)"'
alias gp='git push'
alias gpf!='git push --force'
alias gpf='git push --force-with-lease'
alias gpristine='git reset --hard && git clean -dffx'
alias gr='git reset'
alias grh='git reset --hard'
alias groh='git reset origin/$(git_current_branch) --hard'
alias gl='git log --oneline'

# ============================================================================
# Claude CLI Aliases
# ============================================================================

# Personal Claude (uses Anthropic API key from secrets)
alias claude='claude-code'
alias claude-yolo='claude-code --dangerously-skip-permissions'
alias claude-r='claude-code --resume'
alias claude-yr='claude-code --dangerously-skip-permissions --resume'

{{- if .work }}

# ============================================================================
# Work-specific Aliases
# ============================================================================

# Work Claude (uses AWS Bedrock with work profile)
alias claude-fw='claude-code --profile work'
alias claude-fw-yolo='claude-code --profile work --dangerously-skip-permissions'
alias claude-fw-r='claude-code --profile work --resume'

function aws-fw() {
  echo "→ AWS SSO login..."
  aws sso login --profile sso_platform_sta_dev || return 1

  echo "→ ECR Docker login..."
  aws ecr get-login-password --region us-east-1 --profile sso_platform_sta_dev | \
    docker login --username AWS --password-stdin 339713173028.dkr.ecr.us-east-1.amazonaws.com || return 1

  echo "→ CodeArtifact login..."
  magellan codeartifact login && source "$HOME/.codeartifact_env"

  echo "✓ Work login complete"
}

{{- end }}
