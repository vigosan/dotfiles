#!/bin/bash

if ! command -v op &>/dev/null || ! op account list &>/dev/null 2>&1; then
  echo "⚠️  1Password CLI not authenticated — skipping MonoLisa font install."
  echo "   Sign in with 'op signin' and run: chezmoi apply"
  exit 0
fi

TMPZIP=$(mktemp /tmp/monolisa.XXXXXX.zip)
TMPDIR=$(mktemp -d /tmp/monolisa.XXXXXX)
trap 'rm -rf "$TMPZIP" "$TMPDIR"' EXIT

echo "Downloading MonoLisa font from 1Password..."
op document get "MonoLisa-Plus-stable" --vault "Private" --output "$TMPZIP"

unzip -q "$TMPZIP" -d "$TMPDIR"
cp "$TMPDIR"/ttf/*.ttf ~/Library/Fonts/

echo "MonoLisa font installed."
