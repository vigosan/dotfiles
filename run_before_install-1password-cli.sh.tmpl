#!/bin/bash

# Installs 1Password CLI before chezmoi applies managed files

# Xcode Command Line Tools are required for Homebrew
if ! xcode-select -p &>/dev/null; then
  echo "❌ Xcode Command Line Tools not installed."
  echo "   Run: xcode-select --install"
  echo "   Accept the dialog, wait for installation, then re-run: chezmoi apply"
  exit 1
fi

# Check if op is already available
if command -v op &>/dev/null; then
  echo "1Password CLI already installed."
  exit 0
fi

if [[ $(uname -m) == "arm64" ]]; then
  BREW_BIN="/opt/homebrew/bin/brew"
else
  BREW_BIN="/usr/local/bin/brew"
fi

if ! command -v brew &>/dev/null; then
  echo "Homebrew not found. Installing Homebrew first..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

eval "$($BREW_BIN shellenv)"

echo "Installing 1Password CLI..."
brew install --cask 1password-cli

if command -v op &>/dev/null; then
  echo "1Password CLI installed successfully!"
else
  echo "Warning: 1Password CLI installation may have failed."
  exit 1
fi
