# ============================================================================
# Shared Environment Secrets (Work + Personal)
# ============================================================================
# Secrets are loaded at shell startup via 1Password CLI.
# If op is not available or not authenticated, secrets are skipped silently.

if command -v op &>/dev/null && op account list &>/dev/null 2>&1; then
  export GEMINI_API_KEY="$(op read "op://Private/API Keys/gemini")"
{{- if .work }}
  export PACKAGE_CLOUD_API_TOKEN="$(op read "op://Private/API Keys/package_cloud")"
  export BUNDLE_PACKAGECLOUD__IO="$(op read "op://Private/API Keys/package_cloud")"
  export SIDEKIQ_PRO_CONTRIBSYS_API_TOKEN="$(op read "op://Private/API Keys/sidekiq_pro")"
  export GITLAB_API_TOKEN="$(op read "op://Private/API Keys/gitlab")"
  export JIRA_API_TOKEN="$(op read "op://Private/API Keys/jira")"
  export AWS_PROFILE="$(op read "op://Private/AWS/profile")"
{{- end }}
fi
