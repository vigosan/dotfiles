# ============================================================================
# Shared Environment Secrets (Work + Personal)
# ============================================================================
{{- $op := "" }}
{{- if stat "/opt/homebrew/bin/op" }}{{ $op = "/opt/homebrew/bin/op" }}
{{- else if stat "/usr/local/bin/op" }}{{ $op = "/usr/local/bin/op" }}
{{- else if lookPath "op" }}{{ $op = "op" }}
{{- end }}
{{- $authed := false }}
{{- if ne $op "" }}
{{-   if eq (output "sh" "-c" (printf "%s read --no-newline 'op://Private/API Keys/gemini' >/dev/null 2>&1 && echo ok || true" $op) | trim) "ok" }}
{{-     $authed = true }}
{{-   end }}
{{- end }}
{{- if $authed }}

export GEMINI_API_KEY="{{ onepasswordRead "op://Private/API Keys/gemini" }}"
{{- if .work }}

export PACKAGE_CLOUD_API_TOKEN="{{ onepasswordRead "op://Private/API Keys/package_cloud" }}"
export BUNDLE_PACKAGECLOUD__IO="{{ onepasswordRead "op://Private/API Keys/package_cloud" }}"
export SIDEKIQ_PRO_CONTRIBSYS_API_TOKEN="{{ onepasswordRead "op://Private/API Keys/sidekiq_pro" }}"
export GITLAB_API_TOKEN="{{ onepasswordRead "op://Private/API Keys/gitlab" }}"
export JIRA_API_TOKEN="{{ onepasswordRead "op://Private/API Keys/jira" }}"
export AWS_PROFILE="{{ onepasswordRead "op://Private/AWS/profile" }}"
{{- end }}
{{- else }}

# ⚠️  1Password CLI unavailable or not signed in — secrets NOT loaded.
# Run:  op signin  &&  chezmoi apply
# to populate this file with your API keys.
{{- end }}
