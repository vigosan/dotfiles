#!/usr/bin/env zsh

# ============================================================================
# Environment Variables
# ============================================================================

export CLICOLOR=1
export EDITOR=nvim
export GIT_EDITOR=nvim
export KEYTIMEOUT=1
export LC_ALL=en_US.UTF-8
export TERM="xterm-256color"
export WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'

# libyaml configuration
export LDFLAGS="-L/opt/homebrew/opt/libyaml/lib"
export CPPFLAGS="-I/opt/homebrew/opt/libyaml/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/libyaml/lib/pkgconfig"

# Base PATH - include local bin for chezmoi and other tools
export PATH="$HOME/.local/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# ============================================================================
# Sensitive Environment Variables
# ============================================================================

[[ -f ~/.zshrc.secrets ]] && source ~/.zshrc.secrets

# ============================================================================
# Aliases
# ============================================================================

[[ -f ~/.zshrc.alias ]] && source ~/.zshrc.alias

# ============================================================================
# Completion System
# ============================================================================

zstyle ':completion:*' menu select
zstyle ':completion:*' completer _complete
zstyle ':completion:*' matcher-list '' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' '+l:|=* r:|=*'

autoload -Uz compinit && compinit -C

autoload -U colors && colors
autoload -U bashcompinit && bashcompinit
autoload -U select-word-style
select-word-style bash
zmodload -i zsh/complist

# ============================================================================
# ZSH Options
# ============================================================================

unsetopt menu_complete
unsetopt flowcontrol

setopt prompt_subst
setopt always_to_end
setopt append_history
setopt auto_menu
setopt complete_in_word
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt inc_append_history
setopt interactivecomments
setopt share_history
setopt auto_cd

# ============================================================================
# Zsh Plugins
# ============================================================================

# Load zsh-completions
if [[ -d /opt/homebrew/share/zsh-completions ]]; then
  fpath=(/opt/homebrew/share/zsh-completions $fpath)
fi

# Load autosuggestions
[[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Load syntax highlighting (must be near the end)
[[ -f /opt/homebrew/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ]] && \
  source /opt/homebrew/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

# Load history substring search (must be after syntax highlighting)
[[ -f /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]] && \
  source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh

# Bind keys for history substring search
if [[ -n "${key[Up]}" ]]; then
  bindkey "${key[Up]}" history-substring-search-up
fi
if [[ -n "${key[Down]}" ]]; then
  bindkey "${key[Down]}" history-substring-search-down
fi

# ============================================================================
# External Tool Integrations
# ============================================================================

_zsh_cache_eval() {
  local cache="$HOME/.cache/zsh/$1.zsh"
  local bin="${commands[$1]}"
  if [[ ! -f "$cache" || "$bin" -nt "$cache" ]]; then
    mkdir -p "$HOME/.cache/zsh"
    "${@:2}" > "$cache"
  fi
  source "$cache"
}

_zsh_cache_eval zoxide zoxide init --cmd z zsh
_zsh_cache_eval mise mise activate zsh
_zsh_cache_eval starship starship init zsh

precmd() { echo -ne '\e[1 q' }
{{- if .work }}

# CodeArtifact environment
[[ -f "$HOME/.codeartifact_env" ]] && source "$HOME/.codeartifact_env"

# Added by Magellan CodeArtifact login command
source "$HOME/.codeartifact_env"
{{- end }}
